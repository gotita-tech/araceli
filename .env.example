# Dominio público del sitio. Si no se define, en Vercel se usa el dominio del
# proyecto y, en local, el valor de content/site.json.
NEXT_PUBLIC_SITE_URL=https://araceli.example

# Publica el estudio de contenido (/admin) en un despliegue.
# Sin esta variable, la ruta responde 404 en producción.
ENABLE_ADMIN=false
